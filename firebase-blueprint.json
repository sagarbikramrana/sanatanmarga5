      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { 
          "type": "string", 
          "enum": [
            "super_admin", 
            "admin", 
            "chief_editor", 
            "editor", 
            "journalist", 
            "moderator", 
            "fact_checker", 
            "photographer", 
            "video_editor", 
            "advertiser", 
            "subscriber", 
            "guest",
            "user"
          ] 
        },
        "photoURL": { "type": "string" },
        "bio": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Article": {
      "title": "News Article",
      "description": "Standard news post supporting editorial workflow and scheduling",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "content": { "type": "string" },
        "excerpt": { "type": "string" },
        "categoryId": { "type": "string" },
        "authorId": { "type": "string" },
        "authorName": { "type": "string" },
        "status": { 
          "type": "string", 
          "enum": [
            "draft", 
            "assigned", 
            "under_review", 
            "fact_check", 
            "approved", 
            "scheduled", 
            "published", 
            "archived"
