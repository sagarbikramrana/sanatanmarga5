# Copy this file to .env and fill in real values for your environment.
# Never commit real secrets, API keys, or credentials.

MEDIA_R2_SECRET_ACCESS_KEY=
VITE_FIREBASE_API_KEY=
ADMIN_WHATSAPP=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=
VITE_FIREBASE_PROJECT_ID=
FRONTEND_URL=https://sanatanmarga.com

ADMIN_EMAIL=sagarrana@gmail.com
MEDIA_R2_ACCOUNT_ID=

# ==============================================================================
# SanatanMarga 4.2.8 Production Environment Variables Specification
# GitHub -> Render -> Firebase -> Cloudflare R2 -> Gemini AI
# ==============================================================================

# 1. Node Environment & Server Binding
NODE_ENV=production
PORT=10000

# 2. Canonical URLs & Domains
APP_URL=https://sanatanmarga.com
FRONTEND_URL=https://sanatanmarga.com
CORS_ORIGIN=https://sanatanmarga.com,https://www.sanatanmarga.com

# 3. Frontend API Base URL (Leave empty when client and server run on same domain)
VITE_API_BASE_URL=

# 4. Google Gemini AI Layer (Server-Side Only - Never expose to client)
GEMINI_API_KEY=

# 5. Cloudflare R2 Media Asset Storage (Uploads, Images, Audio)
# Accepts MEDIA_R2_* or CLOUDFLARE_R2_*
MEDIA_R2_ACCOUNT_ID=
MEDIA_R2_ACCESS_KEY_ID=
MEDIA_R2_SECRET_ACCESS_KEY=
MEDIA_R2_BUCKET_NAME=sanatanos-assets
MEDIA_R2_ENDPOINT=
MEDIA_R2_PUBLIC_URL=https://assets.sanatanmarga.com

# 6. Cloudflare R2 High-Availability Snapshot Storage (Feeds, Manifests, Replicas)
# Optional: Defaults to Media R2 credentials if not specified separately
SNAPSHOT_R2_ACCOUNT_ID=
SNAPSHOT_R2_ACCESS_KEY_ID=
SNAPSHOT_R2_SECRET_ACCESS_KEY=
SNAPSHOT_R2_BUCKET_NAME=sanatanos-snapshots
SNAPSHOT_R2_ENDPOINT=
SNAPSHOT_R2_PUBLIC_URL=

# 7. Firebase Client Configuration (Vite Client-Side)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_VAPID_KEY=

# 8. Firebase Admin Service Account (Server-Side Privileged Writes)
# JSON string of the Firebase service account private key credentials
FIREBASE_SERVICE_ACCOUNT=

# 9. Administrative & Alert Notifications (Optional)
ADMIN_EMAIL=sagarrana@gmail.com
ADMIN_WHATSAPP=
EMAIL_USER=
EMAIL_PASS=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=
